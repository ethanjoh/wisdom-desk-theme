{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1180px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary-yellow",
          "color": "#f6c845",
          "name": "Point Yellow"
        },
        {
          "slug": "dark-banner",
          "color": "#111111",
          "name": "Banner Dark"
        },
        {
          "slug": "meta-red",
          "color": "#ff5252",
          "name": "Meta Red"
        },
        {
          "slug": "text-primary",
          "color": "#333333",
          "name": "Text Primary"
        },
        {
          "slug": "text-muted",
          "color": "#777777",
          "name": "Text Muted"
        },
        {
          "slug": "border-light",
          "color": "#e2e2e2",
          "name": "Border Light"
        },
        {
          "slug": "surface-light",
          "color": "#fdfdfd",
          "name": "Surface Light"
        },
        {
          "slug": "surface-card",
          "color": "#eeeeee",
          "name": "Card Gray"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "11px",
          "slug": "small"
        },
        {
          "name": "Normal",
          "size": "13px",
          "slug": "normal"
        },
        {
          "name": "Medium",
          "size": "16px",
          "slug": "medium"
        },
        {
          "name": "Hero Title",
          "size": "26px",
          "slug": "hero-title"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface-light)",
      "text": "var(--wp--preset--color--text-primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "fontSize": "var(--wp--preset--font-size--normal)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700"
        }
      },
      "button": {
        "border": {
          "color": "var(--wp--preset--color--border-light)",
          "radius": "20px",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "transparent",
          "text": "var(--wp--preset--color--text-primary)"
        },
        "spacing": {
          "padding": {
            "top": "6px",
            "bottom": "6px",
            "left": "16px",
            "right": "16px"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--normal)"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "color": {
          "background": "var(--wp--preset--color--primary-yellow)",
          "text": "#111111"
        },
        "border": {
          "radius": "4px"
        },
        "spacing": {
          "padding": {
            "top": "6px",
            "bottom": "6px",
            "left": "14px",
            "right": "14px"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--normal)",
          "fontWeight": "700"
        }
      },
      "core/cover": {
        "color": {
          "background": "var(--wp--preset--color--dark-banner)"
        },
        "spacing": {
          "padding": {
            "top": "70px",
            "bottom": "70px"
          },
          "margin": {
            "bottom": "30px"
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var(--wp--preset--color--meta-red)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/post-terms": {
        "color": {
          "text": "var(--wp--preset--color--meta-red)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      }
    }
  }
}